DISCORD_TOKEN=cole_o_token_do_bot_aqui
CLIENT_ID=cole_o_application_client_id_aqui

# Opcional, mas recomendado durante testes: registra comandos instantaneamente em um servidor.
# Se deixar vazio, o deploy registra comandos globais e pode demorar para aparecer.
GUILD_ID=cole_o_id_do_servidor_aqui

# Opcional: cookie do YouTube para melhorar buscas/streams em alguns casos.
# YOUTUBE_COOKIE=
